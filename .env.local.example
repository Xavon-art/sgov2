# Supabase — project qyatedebfmupzntcltru
# The publishable key is safe to ship to the browser. Do NOT add the database
# password or any service_role / secret key to this file.
NEXT_PUBLIC_SUPABASE_URL=https://qyatedebfmupzntcltru.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Secret pepper used to HMAC one-time passcodes before they are stored.
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_PEPPER=

# Gmail SMTP for transactional mail (invites, OTP codes, welcome letters).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SmartGov
SMTP_FROM_EMAIL=

# Public base URL used to build links inside emails.
NEXT_PUBLIC_SITE_URL=https://sgov.vercel.app
